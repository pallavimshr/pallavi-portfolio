# --- WordPress (headless CMS) ---
# Base URL of your WordPress install. The site works with mock data if this
# is left unset, so you can run it locally without WordPress at all.
WORDPRESS_API_URL=https://cms.yourdomain.com

# --- On-demand ISR revalidation ---
# Shared secret between Next.js and the WordPress webhook (see
# wordpress-setup/theme-functions.php). Generate any long random string.
REVALIDATE_SECRET=change-this-to-a-long-random-string

# --- Contact form ---
# Where the /api/contact route forwards submissions. Point this at a WP
# custom endpoint, a transactional email API, or leave unset to log only.
CONTACT_FORWARD_URL=

# --- Site metadata ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
